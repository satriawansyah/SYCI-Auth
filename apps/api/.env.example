# === App ===
APP_NAME=syci-auth
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# === Database (MySQL/MariaDB) ===
# Used by the running app (via the Prisma MariaDB adapter, discrete fields):
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=syci_auth
DATABASE_USER=root
DATABASE_PASSWORD=

# Used ONLY by `npx prisma migrate` / `prisma studio` (must point to the same DB
# as the fields above). Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:@localhost:3306/syci_auth"

# === Logging ===
LOG_LEVEL=debug   # trace | debug | info | warn | error

# === JWT ===
# Must be a long random string (min 32 chars). Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_EXPIRY=900       # 15 minutes, in seconds
JWT_REFRESH_EXPIRY=604800   # 7 days, in seconds

# === Refresh token cookie ===
REFRESH_TOKEN_COOKIE_NAME=syci_refresh_token
REFRESH_TOKEN_COOKIE_SECURE=false        # set true in production (requires HTTPS)
REFRESH_TOKEN_COOKIE_PATH=/api/v1/auth
REFRESH_TOKEN_COOKIE_DOMAIN=             # e.g. .syci.id in production, leave empty in dev
REFRESH_TOKEN_COOKIE_SAME_SITE=lax       # strict | lax | none

# === CORS / multi-app SSO ===
# Any HTTPS origin ending with this suffix is trusted automatically.
# Add a new subdomain app -> nothing to redeploy here.
# Example: CORS_ALLOWED_DOMAIN=.syci.id  trusts https://app1.syci.id, https://app2.syci.id, etc.
CORS_ALLOWED_DOMAIN=

# Comma-separated explicit origins, for apps outside CORS_ALLOWED_DOMAIN
# (e.g. a staging domain, or non-subdomain apps).
CORS_ALLOWED_ORIGINS=

# Base domain (no protocol, no leading dot) used to validate SSO ?redirect= targets.
# Example: SSO_BASE_DOMAIN=syci.id
SSO_BASE_DOMAIN=
